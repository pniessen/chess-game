# Copy to .env (gitignored) and fill in. Read only by the coach server.
ANTHROPIC_API_KEY=
# Optional, for Jev seats in Claude vs Claude: TYPESAFE_API_KEY. If it is not
# set here or in the shell, the server reads ~/.config/typesafe/env instead.
# Optional, for Gemini seats: they sign in with Google Application Default
# Credentials (gcloud auth application-default login), never a key in this file.
# GOOGLE_CLOUD_PROJECT picks the billed project (default poised-runner-159919).
# GOOGLE_CLOUD_PROJECT=
# Optional: port for the coach server (Vite proxies /api here).
# PORT=8787
