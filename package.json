{
  "name": "chess-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.node.json",
    "e2e": "playwright test",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "openings": "tsx scripts/build-openings.ts",
    "puzzles": "tsx scripts/build-puzzles.ts",
    "curate-puzzles": "tsx scripts/curate-puzzles.ts",
    "start": "npm run build && npm run server",
    "postinstall": "node scripts/copy-engine.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@netlify/blobs": "^11.1.0",
    "chess.js": "^1.4.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stockfish": "^19.0.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
